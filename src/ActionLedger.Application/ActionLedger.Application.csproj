<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AD-1: Application references Domain and nothing else. Its only permitted packages are
    Microsoft.Extensions.Logging.Abstractions, Microsoft.Extensions.DependencyInjection.Abstractions,
    and System.Text.Json.
  -->
  <ItemGroup>
    <ProjectReference Include="../ActionLedger.Domain/ActionLedger.Domain.csproj" />
  </ItemGroup>

  <!-- ApplicationRegistration owns this ring's DI wiring. Abstractions only — allowlisted above. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <!--
    AD-11 — one copy of the extraction schema, read out of this assembly by the extractor above.
    Embedding it means no path configuration, no copy step, and no chance of the api image and
    the tests disagreeing about which document validated a run. System.Text.Json (including
    JsonSchemaExporter) ships in the net10.0 shared framework, so this needs no package.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Ai/extract-actions.schema.json" />
  </ItemGroup>

</Project>
