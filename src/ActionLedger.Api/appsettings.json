{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "AllowedHosts": "*",

  "Ai": {
    "Provider": "Fake",
    "PromptVersion": "v1",
    "CallTimeoutSeconds": 90,
    "LowConfidenceThreshold": 0.70
  },

  "Webhooks": {
    "RetryDelaysSeconds": [ 10, 30, 120, 600, 1800 ],
    "TimeoutSeconds": 10,
    "LeaseSeconds": 60
  },

  "Seed": {
    "Enabled": true
  }
}
