<Project Sdk="Microsoft.NET.Sdk">

  <!-- AD-1: Infrastructure may reference Application and Domain only. -->
  <ItemGroup>
    <ProjectReference Include="../ActionLedger.Application/ActionLedger.Application.csproj" />
    <ProjectReference Include="../ActionLedger.Domain/ActionLedger.Domain.csproj" />
  </ItemGroup>

  <!--
    Everything that knows about a database, a password hash, or a host lives in this ring and
    stops here. AD-1 Rule 3 fails the build if any of it drifts into Domain or Application.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" />
    <!--
      AD-11: the one AI SDK in the tree, and it stops at this ring. The OpenAI SDK and its adapter
      serve both real providers (Story 2.7); Architecture.Tests fails the build if either reaches
      Domain or Application.
    -->
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="OpenAI" />
  </ItemGroup>

  <!--
    AD-6 and AD-21 — the prompt catalog and the fixture catalog travel inside this assembly, so the
    api image, the tests, and the Evaluation Gate all read the same bytes with no path
    configuration and no copy step. The AD-6 line is quoted verbatim from the architecture spine.

    README.md is documentation of the catalog's format, not a case. It is excluded because the
    loader pairs every embedded `<stem>.md` with a `<stem>.expected.json`, and a README with no
    front matter and no answer file would fail that pairing rather than be ignored.
  -->
  <ItemGroup>
    <EmbeddedResource Include="../../prompts/*.md" LogicalName="prompts/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../fixtures/extraction/*"
                      Exclude="../../fixtures/extraction/README.md"
                      LogicalName="fixtures/extraction/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Infrastructure.Tests" />
  </ItemGroup>

</Project>
