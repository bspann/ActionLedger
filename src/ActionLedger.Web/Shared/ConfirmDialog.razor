@* EXPERIENCE.md, Interaction Primitives — "Irreversible writes confirm in a dialog: Save notes,
   Reject, Complete, Cancelled." That is a global primitive, not a notes rule, which is why this
   lives in Shared/ and takes its sentence as a parameter: Epic 3's Reject and Epic 4's Complete
   and Cancelled are the same dialog with different copy.

   Presentational — parameters in, a result out. It raises no request and knows nothing about
   what it is confirming.

   MudDialog is what gives it MudBlazor's own focus trap and focus return, which is why the
   caller opens it through IDialogService rather than toggling a flag on a card. *@
<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body1">@Message</MudText>
    </DialogContent>
    <DialogActions>
        @* Stable ids rather than MudBlazor's own variant classes, which would retarget silently
           the day a Variant changes. Two buttons, so both are named. *@
        <MudButton id="@CancelId" OnClick="Cancel">@Voice.Cancel</MudButton>
        <MudButton id="@ConfirmId"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="Confirm">@ConfirmLabel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>The confirming button's id. Only one dialog is ever open (no modal stacks).</summary>
    public const string ConfirmId = "confirm-dialog-confirm";

    /// <summary>The dismissing button's id.</summary>
    public const string CancelId = "confirm-dialog-cancel";

    [CascadingParameter]
    public IMudDialogInstance Dialog { get; set; } = default!;

    /// <summary>The sentence to repeat. The caller owns it, so it stays one <c>Voice</c> constant.</summary>
    [Parameter]
    [EditorRequired]
    public string Message { get; set; } = string.Empty;

    /// <summary>The confirming button's text — the same verb as the control that opened it.</summary>
    [Parameter]
    [EditorRequired]
    public string ConfirmLabel { get; set; } = string.Empty;

    /// <summary>Closes with <c>true</c>. The caller treats anything else as "do not proceed".</summary>
    private void Confirm() => Dialog.Close(DialogResult.Ok(true));

    private void Cancel() => Dialog.Cancel();
}
