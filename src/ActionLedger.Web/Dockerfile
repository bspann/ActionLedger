# syntax=docker/dockerfile:1

# The web image, built from the repository root:
#
#   docker build -f src/ActionLedger.Web/Dockerfile .
#
# NFR-10 — the demo needs Docker Desktop only. The .NET SDK lives in the build stage and nothing
# else: the final image is nginx serving static WebAssembly assets, with no runtime and no Node
# stage anywhere in it (AD-13, and the 2026-09-21 sprint change that replaced Angular).

# --- build ---------------------------------------------------------------------------------------
# Pinned to the exact patch for the same reason the api build is: global.json asks for 10.0.401
# with `rollForward: disable`, so a floating `10.0` tag breaks this build the day it moves.
FROM mcr.microsoft.com/dotnet/sdk:10.0.401 AS build
WORKDIR /src

# AD-13 — the web project has zero ProjectReference, so the restore layer needs the root props
# files and this one csproj and nothing else.
COPY global.json Directory.Build.props Directory.Packages.props ./
COPY src/ActionLedger.Web/*.csproj src/ActionLedger.Web/

RUN dotnet restore src/ActionLedger.Web/ActionLedger.Web.csproj

COPY src/ActionLedger.Web/ src/ActionLedger.Web/

# Build then publish --no-build, the same shape the api build uses. It is load-bearing here: the
# typed client is generated by the GenerateApiClient target, which hangs off BeforeCompile, and
# Core/Api/ is git-ignored — so the client exists only after a compile has happened in this stage.
RUN dotnet build src/ActionLedger.Web/ActionLedger.Web.csproj -c Release --no-restore

# --- publish -------------------------------------------------------------------------------------
FROM build AS publish
RUN dotnet publish src/ActionLedger.Web/ActionLedger.Web.csproj -c Release --no-build -o /app/publish

# --- final ---------------------------------------------------------------------------------------
FROM nginx:1.30-alpine AS final

# wwwroot/ only. The publish root also holds ActionLedger.Web.runtimeconfig.json, openapi.json and
# web.config — the contract file and an IIS configuration have no business being served.
COPY --from=publish /app/publish/wwwroot/ /usr/share/nginx/html/

# nginx's entrypoint runs envsubst over /etc/nginx/templates/*.template before it starts.
COPY src/ActionLedger.Web/nginx.conf.template /etc/nginx/templates/default.conf.template

# AD-16 — the compose upstream, as the in-image default, so `docker run` on this image alone still
# works and a cloud deployment overrides one variable.
ENV API_UPSTREAM=http://api:8080

# The DNS server nginx re-resolves API_UPSTREAM against. Docker's embedded resolver is 127.0.0.11
# on every user-defined network; a cloud deployment overrides it. It is templated, not hard-coded,
# for the same reason API_UPSTREAM is: one image, two environments.
ENV NGINX_RESOLVER=127.0.0.11

# Without a filter envsubst substitutes every $name in the template, which would blank out $uri,
# $host, $http_host, $scheme, $remote_addr, $request_uri, $upstream and $proxy_add_x_forwarded_for
# and leave a config that either fails to parse or silently proxies nowhere. Set here rather than
# in compose so the property travels with the image to cloud.
ENV NGINX_ENVSUBST_FILTER='^(API_UPSTREAM|NGINX_RESOLVER)$'

EXPOSE 80
