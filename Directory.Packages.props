<Project>

  <!--
    Central Package Management. Versions come from the architecture spine's Stack table.
    Every package here is MIT, Apache-2.0, or BSD (NFR9). Excluded by license:
    FluentAssertions 8+, MediatR 13+, AutoMapper 15+, MassTransit 9, JsonSchema.Net.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
  </ItemGroup>

  <!--
    Microsoft.Testing.Platform arrives transitively through xunit.v3, which asks for ">= 2.4.0"
    rather than an exact version. `dotnet test` on the .NET 10 SDK talks to the test application
    over MTP, and a host/platform version mismatch surfaces as a run that reports zero tests
    rather than as a restore error. Pinning these keeps every machine and every CI agent on the
    same platform build. Bump them together with xunit.v3.
  -->
  <ItemGroup Label="Testing platform (transitive, pinned deliberately)">
    <PackageVersion Include="Microsoft.Testing.Platform" Version="2.4.0" />
    <PackageVersion Include="Microsoft.Testing.Platform.MSBuild" Version="2.4.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.Telemetry" Version="2.4.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport.Abstractions" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup Label="Api (Story 1.2)">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="Persistence (Story 1.3)">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <!--
      `dotnet ef` needs Design on the project it builds the model from. It is a build-time
      dependency (PrivateAssets="all"), so nothing it carries reaches the published api.
    -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- IHostedService for DemoDataSeeder, without Infrastructure taking the whole host. -->
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <!--
      PasswordHasher<User> (AD-12). The type lives in namespace Microsoft.AspNetCore.Identity;
      the package that ships it on .NET 10 is Microsoft.Extensions.Identity.Core — the old
      Microsoft.AspNetCore.Identity package id stopped at 2.3.x. MIT, so NFR9 holds.
    -->
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Application (Story 1.4)">
    <!--
      AddActionLedgerApplication lives in the Application ring, so the ring declares its own DI
      extension point. Abstractions only, and on AD-1's three-package allowlist. MIT.
    -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Web (Story 1.5)">
    <!-- The Blazor WebAssembly host itself; the SDK supplies no implicit version under CPM. -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <!-- `dotnet run` on a WASM project needs the dev server to host wwwroot. Build-time only. -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" />
    <!-- The component library the whole UI is built from (AD-14, DESIGN.md). -->
    <PackageVersion Include="MudBlazor" Version="9.10.0" />
    <!--
      Generates the typed client from the committed contract in a pre-build target (AD-13).
      Build-time only: it ships the generator executable, not a runtime dependency.
    -->
    <PackageVersion Include="NSwag.MSBuild" Version="14.7.1" />
    <!-- bUnit renders components in-process so component tests ride the existing `dotnet test`. -->
    <PackageVersion Include="bunit" Version="2.11.3" />
  </ItemGroup>

  <!--
    The provider-neutral chat-client abstraction the AI seam is built on (AD-11, Story 2.4).
    MIT, so NFR9 holds. The versions are the spine's Stack table pins. Story 2.7 adds the OpenAI
    SDK (MIT) and its Microsoft.Extensions.AI adapter (MIT): LocalOpenAI and AzureOpenAI are both
    this one SDK, differing only in endpoint, model, and credential — no Azure-specific SDK.
  -->
  <ItemGroup Label="AI seam (Stories 2.4, 2.7)">
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.0" />
    <PackageVersion Include="OpenAI" Version="2.14.0" />
  </ItemGroup>

  <!--
    NFR-4 — the Application ring writes the ExtractionRunCompleted event through ILogger<T>. On
    AD-1's three-package allowlist from the first commit; Story 2.5 is the first use. MIT, so NFR9
    holds. Abstractions only: the logging implementation stays in the host.
  -->
  <ItemGroup Label="Application logging (Story 2.5)">
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Architecture rules">
    <PackageVersion Include="NetArchTest.eNhancedEdition" Version="1.4.5" />
  </ItemGroup>

</Project>
