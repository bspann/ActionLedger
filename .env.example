# ActionLedger — every configuration key, with placeholders only. Copy to `.env` and fill in.
#
#   cp .env.example .env
#
# `.env` is git-ignored: no real value is ever committed (AD-16, NFR5). Compose reads this file
# and passes each key to the containers. .NET maps `__` to the `:` in a configuration key, so
# `Ai__Provider` here is `Ai:Provider` in the application.
#
# A missing or malformed required key fails the host at startup with a message naming the key.
# There is no partial start.

# --- AI provider -------------------------------------------------------------------------------
# One of: Fake | LocalOpenAI | AzureOpenAI. Fake is the compose default — it answers from the
# committed fixtures, so the demo runs with no model server and no credential.
Ai__Provider=Fake

# The prompt revision the extractor asks the catalog for. Must exist in the catalog.
Ai__PromptVersion=v1

# Seconds allowed for one provider call. A run makes at most two.
Ai__CallTimeoutSeconds=90

# Confidence at or below which a Proposed Action is flagged Low Confidence on the Review screen.
Ai__LowConfidenceThreshold=0.70

# Required when Ai__Provider=LocalOpenAI. LM Studio or Ollama, OpenAI-compatible.
# From inside a container, the host is reachable as host.docker.internal.
Ai__LocalOpenAI__BaseUrl=http://host.docker.internal:1234/v1
Ai__LocalOpenAI__Model=replace-with-your-local-model-id

# Required when Ai__Provider=AzureOpenAI. The ApiKey is a secret — never commit a real one.
Ai__AzureOpenAI__Endpoint=https://replace-me.openai.azure.com/openai/v1/
Ai__AzureOpenAI__Model=replace-with-your-deployment-name
Ai__AzureOpenAI__ApiKey=replace-with-your-api-key

# --- Authentication ----------------------------------------------------------------------------
# HS256 signing key for the 8-hour session token. At least 32 characters. A secret: generate your
# own, for example with `openssl rand -base64 48`.
Jwt__Key=replace-with-at-least-32-characters-of-random-key

# The issuer stamped into, and required on, every token.
Jwt__Issuer=actionledger

# --- Database ----------------------------------------------------------------------------------
# PostgreSQL. A secret: it carries the password. The compose value points at the `db` service.
Database__ConnectionString=Host=db;Port=5432;Database=actionledger;Username=actionledger;Password=replace-me

# --- Webhooks ----------------------------------------------------------------------------------
# Delivery retry schedule in seconds: 10s, 30s, 2m, 10m, 30m, then the message is Dead.
Webhooks__RetryDelaysSeconds__0=10
Webhooks__RetryDelaysSeconds__1=30
Webhooks__RetryDelaysSeconds__2=120
Webhooks__RetryDelaysSeconds__3=600
Webhooks__RetryDelaysSeconds__4=1800

# Seconds allowed for one webhook POST.
Webhooks__TimeoutSeconds=10

# Seconds a dispatcher holds a claimed outbox message before another may take it.
Webhooks__LeaseSeconds=60

# --- Seeding -----------------------------------------------------------------------------------
# True in compose so a clean clone comes up with demo data; cd.yml sets it false.
Seed__Enabled=true

# --- Web image ---------------------------------------------------------------------------------
# Read by the `web` container at start and templated into its nginx config, so the same image
# serves compose and cloud.
API_UPSTREAM=http://api:8080
